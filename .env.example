# Copy to .env.local for local dev. Add the same two values in Vercel → Settings → Environment Variables.
# Supabase dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Either the new "publishable" key (sb_publishable_...) or the legacy "anon" key works here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
