# Copy to .env.local for local dev. Add the same two values in Vercel → Settings → Environment Variables.
# These are the real values for the "gacha-hq" Supabase project (org gacha-hq, ref ixipxzwdwkhgtfurksec).
# The publishable key is safe to expose to browsers; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://ixipxzwdwkhgtfurksec.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4YBTqrQ47NfVHgzbDnrwlg_nxfCrac-

# SERVER ONLY — never NEXT_PUBLIC_, never committed with a real value. Needed for in-game
# signature verification / account takeover. Supabase → Project Settings → API Keys → Secret keys.
# Set it in Vercel → Settings → Environment Variables (and in .env.local for local dev).
SUPABASE_SECRET_KEY=

# Optional: set to 1 (in Vercel too) once the Google provider is enabled in Supabase — shows "Continue with Google".
NEXT_PUBLIC_GOOGLE_SIGNIN=
